# Use the existing authenticated WebSocket endpoint.
WS_URL=wss://example.org/ws
AGGREGATOR_ID=img3d-aggregator-01
AGGREGATOR_TOKEN=replace-with-a-distinct-random-token
DATA_DIR=/var/www/html/data

# Repository publisher CLI. Keep this interpreter and script path aligned with
# the deployed checkout and install the Python dependencies into this interpreter.
PUBLISHER_CLI=/usr/bin/python3
PUBLISHER_SCRIPT=/opt/3dFromVideo/system/py/geom_publish_glb.py
PUBLISHER_TIMEOUT_MS=1200000
MOGE_EXPECTED_CODE_REVISION=74fbce054ebed49800de42d0ad0e83495065719a
MOGE_EXPECTED_CHECKPOINT_SHA256=replace-with-the-approved-64-hex-checkpoint-digest
